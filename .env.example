# Supabase Credentials (Public Client)
VITE_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Google Gemini API Key (Server-Side Only - Used in Vercel Serverless /api)
GEMINI_API_KEY=your-google-gemini-api-key-placeholder

# LangSmith Observability & Tracing (Server-Side Only - Used in Vercel Serverless /api)
LANGSMITH_API_KEY=your-langsmith-api-key-placeholder
LANGSMITH_PROJECT=animopulse-ai
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_BACKGROUND=false
